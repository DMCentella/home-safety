<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
<nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="#">Home Safety</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">

        <!-- Sobre Nosotros -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Sobre Nosotros</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="#">Nuestra Historia</a></li>
            <li><a class="dropdown-item" href="#">Misión y Visión</a></li>
          </ul>
        </li>

        <!-- Servicios médicos -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Servicios médicos</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="#">Especialidades</a></li>
            <li><a class="dropdown-item" href="#">Consultorios</a></li>
          </ul>
        </li>

        <!-- Doctores -->
        <li class="nav-item">
          <a class="nav-link" href="#">Doctores</a>
        </li>

        <!-- Reservar cita -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Reservar cita</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="#">Reservar</a></li>
            <li><a class="dropdown-item" href="#">Mis citas</a></li>
          </ul>
        </li>

        <!-- Pacientes -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Pacientes</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="#">Buscar paciente</a></li>
            <li><a class="dropdown-item" href="#">Registrar paciente</a></li>
          </ul>
        </li>

        <!-- Mi agenda -->
        <li class="nav-item">
          <a class="nav-link" href="#">Mi agenda</a>
        </li>

        <!-- Reportes -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Reportes</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="#">Citas por fechas</a></li>
            <li><a class="dropdown-item" href="#">Inasistencias</a></li>
          </ul>
        </li>

        <!-- Gestiones -->
        <li class="nav-item">
          <a class="nav-link" href="#">Gestiones</a>
        </li>
      </ul>

      <ul class="navbar-nav">
        <c:choose>
          <c:when test="${not empty sessionScope.usuario}">
            <li class="nav-item">
              <span class="nav-link">Hola, ${sessionScope.usuario}</span>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="${pageContext.request.contextPath}/auth/logout">Salir</a>
            </li>
          </c:when>
          <c:otherwise>
            <li class="nav-item">
              <a class="nav-link" href="${pageContext.request.contextPath}/auth/login">Ingresar</a>
            </li>
          </c:otherwise>
        </c:choose>
      </ul>
    </div>
  </div>
</nav>
<div class="container my-4">
</div><!-- /.container -->
