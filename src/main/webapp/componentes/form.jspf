<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>

<c:set var="formAction" value="${param.accion}" />
<c:if test="${empty formAction}">
  <c:set var="formAction" value="${pageContext.request.contextPath}/PacienteRegistra"/>
</c:if>

<div class="card card-soft">
  <div class="card-body">

    <c:if test="${not empty error}">
      <div class="alert alert-danger py-2 mb-3">${error}</div>
    </c:if>
    <c:if test="${not empty msg}">
      <div class="alert alert-success py-2 mb-3">${msg}</div>
    </c:if>

    <form method="post" action="${formAction}" novalidate>
      <input type="hidden" name="next" value="${param.next}"/>

      <div class="row g-3">
        <div class="col-md-3">
          <label class="form-label">DNI <span class="text-danger">*</span></label>
          <input name="dni" class="form-control" maxlength="8" pattern="[0-9]{8}" 
                 value="${param.dni}" required 
                 title="Debe contener exactamente 8 dígitos">
          <div class="invalid-feedback">DNI debe tener 8 dígitos</div>
        </div>

        <div class="col-md-5">
          <label class="form-label">Nombres <span class="text-danger">*</span></label>
          <input name="nombre" class="form-control" value="${param.nombre}" required
                 maxlength="100" title="Solo letras y espacios">
          <div class="invalid-feedback">Nombres es requerido</div>
        </div>
        <div class="col-md-4">
          <label class="form-label">Apellidos <span class="text-danger">*</span></label>
          <input name="apellido" class="form-control" value="${param.apellido}" required
                 maxlength="100" title="Solo letras y espacios">
          <div class="invalid-feedback">Apellidos es requerido</div>
        </div>

        <div class="col-md-3">
          <label class="form-label">Fecha de nacimiento <span class="text-danger">*</span></label>
          <input type="date" name="fecha_nacimiento" class="form-control" 
                 value="${param.fecha_nacimiento}" required
                 min="1900-01-01">
          <div class="invalid-feedback">Fecha de nacimiento es requerida</div>
        </div>
        <div class="col-md-3">
          <label class="form-label">Género <span class="text-danger">*</span></label>
          <select name="genero" class="form-select" required>
            <option value="">Seleccione...</option>
            <option value="M" ${param.genero == 'M' ? 'selected' : ''}>Masculino</option>
            <option value="F" ${param.genero == 'F' ? 'selected' : ''}>Femenino</option>
          </select>
          <div class="invalid-feedback">Debe seleccionar un género</div>
        </div>

        <div class="col-md-3">
          <label class="form-label">Teléfono</label>
          <input name="telefono" class="form-control" value="${param.telefono}"
                 maxlength="15" title="Solo números, espacios, + y -">
        </div>
        <div class="col-md-3">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" value="${param.email}"
                 maxlength="100">
        </div>

        <div class="col-md-4">
          <label class="form-label">Seguro médico</label>
          <input name="seguro_medico" class="form-control" value="${param.seguro_medico}"
                 maxlength="100">
        </div>
      </div>

      <hr class="my-3">

      <h6>Residencia</h6>
      <div class="row g-3">
        <div class="col-md-12">
          <label class="form-label">Dirección</label>
          <input name="direccion_residencia" class="form-control" 
                 value="${param.direccion_residencia}" maxlength="200">
        </div>
        <div class="col-md-4">
          <label class="form-label">Departamento</label>
          <input name="depto_residencia" class="form-control" 
                 value="${param.depto_residencia}" maxlength="50">
        </div>
        <div class="col-md-4">
          <label class="form-label">Provincia</label>
          <input name="prov_residencia" class="form-control" 
                 value="${param.prov_residencia}" maxlength="50">
        </div>
        <div class="col-md-4">
          <label class="form-label">Distrito</label>
          <input name="dist_residencia" class="form-control" 
                 value="${param.dist_residencia}" maxlength="50">
        </div>
        <div class="col-md-4">
          <label class="form-label">N° Departamento</label>
          <input name="num_departamento" class="form-control" 
                 value="${param.num_departamento}" maxlength="10">
        </div>
        <div class="col-md-8">
          <label class="form-label">Urbanización</label>
          <input name="urbanizacion" class="form-control" 
                 value="${param.urbanizacion}" maxlength="100">
        </div>
      </div>

      <hr class="my-3">

      <h6>Nacimiento</h6>
      <div class="row g-3">
        <div class="col-md-12">
          <label class="form-label">Dirección</label>
          <input name="direccion_nacimiento" class="form-control" 
                 value="${param.direccion_nacimiento}" maxlength="200">
        </div>
        <div class="col-md-4">
          <label class="form-label">Departamento</label>
          <input name="depto_nacimiento" class="form-control" 
                 value="${param.depto_nacimiento}" maxlength="50">
        </div>
        <div class="col-md-4">
          <label class="form-label">Provincia</label>
          <input name="prov_nacimiento" class="form-control" 
                 value="${param.prov_nacimiento}" maxlength="50">
        </div>
        <div class="col-md-4">
          <label class="form-label">Distrito</label>
          <input name="dist_nacimiento" class="form-control" 
                 value="${param.dist_nacimiento}" maxlength="50">
        </div>
      </div>

      <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary" type="submit" id="btnGuardar">
          <span class="spinner-border spinner-border-sm d-none" role="status"></span>
          Guardar
        </button>
        <a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}/home.jsp">Cancelar</a>
      </div>

      <div class="form-text mt-2">
        <span class="text-danger">*</span> Campos requeridos<br>
        Registro manual por personal autorizado (Admin/Recepción).
      </div>
    </form>
  </div>
</div>

<script>
(function() {
    'use strict';
    
    const form = document.querySelector('form');
    const btnGuardar = document.getElementById('btnGuardar');
    
    const fechaNacimiento = document.querySelector('input[name="fecha_nacimiento"]');
    if (fechaNacimiento) {
        fechaNacimiento.setAttribute('max', new Date().toISOString().split('T')[0]);
    }
    
    const dniInput = document.querySelector('input[name="dni"]');
    if (dniInput) {
        dniInput.addEventListener('input', function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
            if (this.value.length > 8) {
                this.value = this.value.substring(0, 8);
            }
        });
    }
    
    const nameInputs = document.querySelectorAll('input[name="nombre"], input[name="apellido"]');
    nameInputs.forEach(input => {
        input.addEventListener('input', function(e) {
            this.value = this.value.replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ\s]/g, '');
        });
    });
    
    const telefonoInput = document.querySelector('input[name="telefono"]');
    if (telefonoInput) {
        telefonoInput.addEventListener('input', function(e) {
            this.value = this.value.replace(/[^0-9+\-\s]/g, '');
        });
    }
    
    form.addEventListener('submit', function(event) {
        if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
        } else {
            const spinner = btnGuardar.querySelector('.spinner-border');
            if (spinner) {
                spinner.classList.remove('d-none');
                btnGuardar.disabled = true;
            }
        }
        
        form.classList.add('was-validated');
    });
})();
</script>