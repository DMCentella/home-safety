<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>${pageTitle != null ? pageTitle : "Home Safety"}</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>

  <style>
    :root{
      --hs-primary:#0b6efd;
      --hs-ink-2:#6b7280;
    }
    body{background:#f6f8fb}
    .card-soft{border:1px solid rgba(0,0,0,.06);box-shadow:0 6px 20px rgba(0,0,0,.05)}
    .table thead th{background:#f1f5f9}
    .hero{background:linear-gradient(180deg,#e8f0ff,transparent)}

    .topbar{
      background:linear-gradient(90deg,#0b2a4a,#0a2240); color:#cfe9ff;
    }
    .topbar a{ color:#9ed1ff; text-decoration:none }
    .topbar a:hover{ text-decoration:underline }

    .navbar-wrap{
      position: sticky; top:0; z-index:1030;
      backdrop-filter: blur(8px);
      background:linear-gradient(180deg,rgba(255,255,255,.92),rgba(255,255,255,.86));
      transition: box-shadow .2s ease, background .2s ease;
    }
    .navbar-wrap.scrolled{ box-shadow:0 6px 24px rgba(0,0,0,.08); background:rgba(255,255,255,.98); }

    .navbar-brand{ display:flex; align-items:center; gap:.6rem; font-weight:800; letter-spacing:.2px; }
    .navbar-brand img { width:56px; height:56px; border-radius:12px; object-fit:cover; }

    .navbar .nav-link{ position:relative; font-weight:500; }
    .navbar .nav-link:hover{ color:#0b6efd!important; }
    .navbar .nav-link::after{
      content:""; position:absolute; left:.6rem; right:.6rem; bottom:.25rem;
      height:2px; transform:scaleX(0); transform-origin:left; background:var(--hs-primary);
      transition: transform .2s ease;
    }
    .navbar .nav-link:hover::after,.navbar .nav-link.active::after{ transform:scaleX(1); }

    .navbar .dropdown-menu{
      border:1px solid rgba(0,0,0,.06);
      box-shadow:0 12px 40px rgba(0,0,0,.08);
      border-radius:.6rem;
      margin-top:0 !important;
      transform: translateY(2px);
    }
    .dropdown-item{ padding:.55rem .85rem }

    @media (min-width: 992px){
      .dropdown-hover:hover > .dropdown-menu{ display:block; }
    }

    .btn-cta{ background-image:linear-gradient(180deg,var(--hs-primary),#0a58ca); border:none; box-shadow:0 8px 18px rgba(13,110,253,.25); }

    .nav-avatar{ width:40px; height:40px; border-radius:50%; object-fit:cover; border:2px solid #eef2ff; box-shadow:0 0 0 2px #fff; }
    .online-dot{ position:absolute; right:0; bottom:0; width:10px; height:10px; background:#22c55e; border:2px solid #fff; border-radius:50%; }
  </style>
</head>
<body>

<div class="topbar py-1">
  <div class="container d-flex flex-wrap justify-content-between small">
    <div class="d-flex gap-3">
      <span>☎️ <a href="tel:+51015551111">(+51) 01 555 1111</a></span>
      <span>✉️ <a href="mailto:contacto@homesafety.pe">contacto@homesafety.pe</a></span>
    </div>
    <div class="d-flex gap-3"></div>
  </div>
</div>

<div class="navbar-wrap border-bottom">
  <nav class="navbar navbar-expand-lg bg-transparent">
    <div class="container">
      <a class="navbar-brand" href="${pageContext.request.contextPath}/home.jsp">
        <img src="${pageContext.request.contextPath}/img/logosoloicono.png" alt="Logo Home Safety">
        <span>Home Safety</span>
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Menú">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">

          <li class="nav-item dropdown dropdown-hover">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Sobre Nosotros</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="${pageContext.request.contextPath}/historia.jsp">Nuestra Historia</a></li>
              <li><a class="dropdown-item" href="${pageContext.request.contextPath}/mision-vision.jsp">Misión y Visión</a></li>
            </ul>
          </li>

          <li class="nav-item dropdown dropdown-hover">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Servicios médicos</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="${pageContext.request.contextPath}/especialidades.jsp">Especialidades</a></li>
              <li><a class="dropdown-item" href="${pageContext.request.contextPath}/teleconsultas.jsp">Teleconsultas</a></li>
            </ul>
          </li>

          <li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/doctores.jsp">Doctores</a></li>

          <li class="nav-item dropdown dropdown-hover">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Reservar cita</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="${pageContext.request.contextPath}/paciente-registrar.jsp">Registrarse como paciente</a></li>
              <li><a class="dropdown-item" href="${pageContext.request.contextPath}/reservar">Reservar</a></li>
              <li><a class="dropdown-item" href="${pageContext.request.contextPath}/mis-citas">Mis citas</a></li>
            </ul>
          </li>

          <li class="nav-item dropdown dropdown-hover">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Pacientes</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="<c:url value='/pacientes'/>">Buscar paciente</a></li>
              <li><a class="dropdown-item" href="${pageContext.request.contextPath}/paciente-nuevo.jsp">Registrar paciente</a></li>
            </ul>
          </li>

  <c:if test="${sessionScope.rol == 'MEDICO'}">
  <li class="nav-item">
    <a class="nav-link" href="<c:url value='/medico/mi-agenda'/>">Mi agenda</a>
  </li>
</c:if>

          <li class="nav-item dropdown dropdown-hover">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Reportes</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="${pageContext.request.contextPath}/reportes-citas-fechas.jsp">Citas por fechas</a></li>
              <li><a class="dropdown-item" href="${pageContext.request.contextPath}/reportes-inasistencias.jsp">Inasistencias</a></li>
            </ul>
          </li>

<c:if test="${sessionScope.rol == 'ADMIN'}">
  <li class="nav-item">
    <a class="nav-link" href="<c:url value='/admin/gestiones'/>">Gestiones</a>
  </li>
</c:if>
        </ul>

        <div class="d-flex align-items-center gap-2">
          <c:choose>
            <c:when test="${not empty sessionScope.username}">
              <span class="small text-muted d-none d-lg-inline">Hola, <strong>${sessionScope.username}</strong></span>

              <div class="dropdown">
                <a href="#" class="d-inline-block position-relative" data-bs-toggle="dropdown" aria-expanded="false">
                  <c:set var="fotoUrl" value="${sessionScope.fotoPerfil}" />
                  <c:choose>
                    <c:when test="${not empty fotoUrl}">
                      <img src="${fotoUrl}" alt="Perfil" class="nav-avatar">
                    </c:when>
                    <c:otherwise>
                      <c:set var="ini" value="${fn:toUpperCase(fn:substring(sessionScope.username,0,1))}" />
                      <img src="https://ui-avatars.com/api/?name=${ini}&background=0D6EFD&color=fff&size=128" alt="Perfil" class="nav-avatar">
                    </c:otherwise>
                  </c:choose>
                  <span class="online-dot"></span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                  <li class="px-3 py-2 small text-muted">
                    <div class="fw-semibold">${sessionScope.username}</div>
                    <div>${sessionScope.rol}</div>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item" href="${pageContext.request.contextPath}/perfil.jsp">Mi perfil</a></li>
                  <li><a class="dropdown-item" href="${pageContext.request.contextPath}/configuracion.jsp">Configuración</a></li>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item text-danger" href="${pageContext.request.contextPath}/logout">Cerrar sesión</a></li>
                </ul>
              </div>
            </c:when>
            <c:otherwise>
              <a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/login.jsp">Ingresar</a>
              <a class="btn btn-cta btn-primary" href="${pageContext.request.contextPath}/register.jsp">Registrarse</a>
            </c:otherwise>
          </c:choose>
        </div>
      </div>
    </div>
  </nav>
</div>

<div class="container mt-4">

<script>
  (function(){
    const wrap = document.querySelector('.navbar-wrap');
    const onScroll = () => {
      if (!wrap) return;
      if (window.scrollY > 8) wrap.classList.add('scrolled'); else wrap.classList.remove('scrolled');
    };
    document.addEventListener('scroll', onScroll, {passive:true});
    onScroll();
  })();
</script>