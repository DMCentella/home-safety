<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  (function(){
    const wrap = document.querySelector('.navbar-wrap');
    const onScroll = () => {
      if (!wrap) return;
      if (window.scrollY > 4) wrap.classList.add('scrolled');
      else wrap.classList.remove('scrolled');
    };
    onScroll(); window.addEventListener('scroll', onScroll, {passive:true});
  })();

  (function(){
    const here = window.location.pathname.replace(/\/+$/, '');
    document.querySelectorAll('.navbar .nav-link').forEach(a => {
      const href = a.getAttribute('href') || '';
      if (!href) return;
      const path = href.split('?')[0].replace(/\/+$/, '');
      if (path && here.endsWith(path)) {
        a.classList.add('active');
      }
    });
  })();

  (function(){
    const mql = window.matchMedia('(min-width: 992px)');
    function bindHover(){
      document.querySelectorAll('.nav-item.dropdown').forEach(it=>{
        const link = it.querySelector('.nav-link.dropdown-toggle');
        const menu = it.querySelector('.dropdown-menu');
        if(!link || !menu) return;
        it.addEventListener('mouseenter', ()=>{ if(mql.matches){ new bootstrap.Dropdown(link).show(); }});
        it.addEventListener('mouseleave', ()=>{ if(mql.matches){ new bootstrap.Dropdown(link).hide(); }});
      });
    }
    bindHover();
    mql.addEventListener?.('change', bindHover);
  })();
</script>

</body>

</html>